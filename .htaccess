# ==========================================================
# Root .htaccess
#
# Ideally your hosting's document root points straight at /public.
# On shared hosting where you cannot change the document root (you just
# drop the whole project into public_html), this file quietly forwards
# every request into /public so the site still works — and app/ and
# config/ still stay unreachable from the browser.
# ==========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the request already points inside /public, leave it alone.
    RewriteCond %{REQUEST_URI} ^/?public/ [OR]
    RewriteCond %{REQUEST_URI} ^/?$
    RewriteRule ^$ public/index.php [L]

    # Forward everything else into /public.
    RewriteCond %{REQUEST_URI} !^/?public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes

# ---------- Second lock: files that must never be served ----------
# If mod_rewrite is missing, the rules above do nothing and the project
# folder itself could be browsed. These block the sensitive parts anyway
# (each private folder also carries its own "deny all" .htaccess).
<IfModule mod_alias.c>
    RedirectMatch 404 (?i)/\.(git|env|svn|ht)
    RedirectMatch 404 (?i)^/?(app|config|storage|migrations|bin)(/|$)
</IfModule>
<FilesMatch "(?i)(\.(sql|md|log|ini|sh|bak|swp|dist|lock|key)|^server\.php|^composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
