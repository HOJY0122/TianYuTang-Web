# Front controller: send every request that is not a real file or folder
# to index.php, so the Router decides what to do with it.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let real files (CSS, images) and real folders be served directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Never list the contents of a folder.
Options -Indexes

# No hidden files (.htaccess, .git …) and no editor or backup leftovers.
<FilesMatch "(?i)(^\.|\.(bak|swp|old|orig|sql|log|ini|md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    # Images and scripts are only what they claim to be.
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
