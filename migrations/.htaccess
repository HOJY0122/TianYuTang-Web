# Not for the web: nothing in this folder may ever be downloaded or run.
# (The site is served from public/; this is the second lock in case the
# whole project folder is ever exposed, e.g. on hosting without rewrite.)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
