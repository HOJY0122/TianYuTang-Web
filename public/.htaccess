# Front controller: send every request that is not a real file or folder
# to index.php, so the Router decides what to do with it.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let real files (CSS, images) and real folders be served directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Never list the contents of a folder.
Options -Indexes

# No hidden files (.htaccess, .git …) and no editor or backup leftovers.
<FilesMatch "(?i)(^\.|\.(bak|swp|old|orig|sql|log|ini|md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    # Images and scripts are only what they claim to be.
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Upload limits (Apache + mod_php; PHP-FPM reads public/.user.ini instead).
# One picture per request is the norm (bulk uploads queue them), so these
# are per-request ceilings.
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 64M
    php_value max_file_uploads 60
    php_value memory_limit 512M
    php_value max_execution_time 240
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 64M
    php_value max_file_uploads 60
    php_value memory_limit 512M
    php_value max_execution_time 240
</IfModule>
